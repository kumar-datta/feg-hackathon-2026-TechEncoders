         via document.cookie without requiring a server-side Set-Cookie header. --><!-- Global HTML attributes --><script>
      (function () {
        const ua = navigator.userAgent
        let device = 'other'
        if (/iPhone|iPad|iPod/i.test(ua)) { device = 'ios' }
        else if (/Android/i.test(ua)) {device = 'android'}
        else if (/Windows NT|Win64|Windows/i.test(ua)) {device = 'windows'}
        else if (/Macintosh|Mac OS X|MacOS/i.test(ua)) {device = 'mac'}
        document.documentElement.setAttribute('data-device', device)
        if (!(window.matchMedia('(hover: hover) and (pointer: fine)').matches)) {
          document.documentElement.setAttribute('data-touch', '')
        }
      })()
    </script><!-- Global Variables --><script>(function(){const APIGW_URL = "https://api.psk.hr";
