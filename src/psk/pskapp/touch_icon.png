  if (isWindows) {
    document.documentElement.classList.add('uwp-scrollbar-windows')
  }
})()
</script><script>
(function() {
  
  const storageKey = 'vueuse-color-scheme'
  const colorModes = ['dark', 'light']
  const validCookieModes = [...colorModes, 'auto']

  function setThemeFromQueryParam() {
    try {
      const value = new URLSearchParams(window.location.search).get('theme')?.trim().toLowerCase()
      if (value && validCookieModes.includes(value)) {
        document.cookie = 'theme=' + value + '; path=/; max-age=31536000; SameSite=Lax'
      }
    } catch (e) {
      // Theme falls to default on parse errors.
    }
  }

  function getCookieTheme() {
    try {
      const themeCookie = document.cookie
        .split(';')
        .map((cookie) => cookie.trim())
        .find((cookie) => cookie.startsWith('theme='))

      if (!themeCookie) {
        return null
      }

      const value = decodeURIComponent(themeCookie.slice('theme='.length)).trim().toLowerCase()
      return validCookieModes.includes(value) ? value : null
    } catch (e) {
      return null
    }
  }
  
  function getStoredColorMode() {
    try {
      const savedColorMode = localStorage.getItem(storageKey)
      return colorModes.includes(savedColorMode) ? savedColorMode : null
    } catch (e) {
      return null
    }
  }

  const getSystemColorMode = () => 
    !window.matchMedia || window.matchMedia('(prefers-color-scheme: dark)').matches 
      ? 'dark' 
      : 'light'

  function applyColorMode(mode) {
    const mfClass = mode === 'dark' ? 'theme-dark' : 'theme-light'
    document.documentElement.classList.add(mfClass, mode)
  }
  
  function applyTheme() {
    setThemeFromQueryParam()
    const cookieTheme = getCookieTheme() || window.THEME_DEFAULT

    if (cookieTheme) {
      try {
        // Store the raw preference ('auto' included) so VueUse picks it up correctly on hydration.
        localStorage.setItem(storageKey, cookieTheme)
      } catch (e) {
        // Ignore storage errors, fallback flow still applies the theme.
      }
    }

    const userPreference = cookieTheme || getStoredColorMode() || 'system'
    // 'auto' and 'system' both resolve to the system color scheme for class application.
    const activeMode =
      (userPreference === 'system' || userPreference === 'auto') ? getSystemColorMode() : userPreference
    applyColorMode(activeMode)
  }
  // due to firefox not supporting view transitions, we need to apply theme class also on route change
  document.addEventListener('astro:after-swap', applyTheme)
  applyTheme()
})()
  
</script><script>
(function() {
  const storageKey = 'reduced-motion'
  
  function getStoredPreference() {
    try {
      return localStorage.getItem(storageKey) === 'true'
    } catch (e) {
      return false
    }
  }

  const getSystemPreference = () => 
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches

  function applyReducedMotion(reduced) {
    if (reduced) {
      document.documentElement.classList.add('reduce-motion')
    } else {
      document.documentElement.classList.remove('reduce-motion')
    }
  }
  
  function applyPreference() {
    const userPreference = getStoredPreference()
    const systemPreference = getSystemPreference()
    const activePreference = userPreference || systemPreference
    applyReducedMotion(activePreference)
  }

  if (window.matchMedia) {
    window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      applyReducedMotion(e.matches)
    })
  }

  applyPreference()
})()
