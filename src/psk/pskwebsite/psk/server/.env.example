# Copy this file to .env and adjust as needed.

# MongoDB connection string.
# Local install:  mongodb://127.0.0.1:27017/psk_demo
# Atlas cluster:  mongodb+srv://<user>:<pass>@<cluster>/psk_demo
MONGODB_URI=mongodb://127.0.0.1:27017/psk_demo

# Port the Express API listens on.
PORT=5000

# Secret used to sign JWTs. Change this to any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Origin allowed by CORS (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# ============================================================
# AI ASSISTANT
# ============================================================
# Leave AI_API_KEY empty to run the assistant in DETERMINISTIC mode:
# entity resolution, intent routing, navigation and extractive answers all
# work with no external API. Adding a key enables LLM-written answers and
# semantic embeddings.

# openai | anthropic | google | groq | together | ollama | none
AI_PROVIDER=none

# <-- PUT YOUR API KEY HERE
AI_API_KEY=

# Chat model used to phrase grounded answers (see docs for options)
AI_MODEL=

# Embedding model used for semantic retrieval. Leave empty to use the
# built-in lexical/hash fallback (works, just less semantic).
AI_EMBED_MODEL=

# Optional: override the provider base URL (self-hosted, proxy, Ollama)
AI_BASE_URL=

# Max tokens for a generated answer
AI_MAX_TOKENS=600
